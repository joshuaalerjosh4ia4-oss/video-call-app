# Base URL of the backend REST API. Do NOT use "localhost" when testing on a
# physical device - use your computer's LAN IP address instead, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://192.168.100.22:3000

# WebSocket signaling URL. Same host as above, using the ws:// scheme and the
# WS_PATH configured on the server (default "/ws").
EXPO_PUBLIC_WS_URL=ws://192.168.100.22:3000/ws

# This app uses React Navigation directly and does not use expo-router.
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
