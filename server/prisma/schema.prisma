// Prisma schema for the SimpleCall video calling backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  FINALIZED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms        Room[]
  enrollments  Enrollment[]
  sections     CourseSection[]
  admissions   Admission[]

  @@map("users")
}

model Room {
  id        String    @id
  passcode  String
  ownerId   String?
  startsAt  DateTime?
  endsAt    DateTime?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([ownerId])
  @@map("rooms")
}

model Enrollment {
  id          String   @id @default(uuid())
  courseCode  String
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([studentId, courseCode])
  @@index([courseCode])
  @@map("enrollments")
}

model CourseSection {
  id          String       @id @default(uuid())
  code        String       @unique
  course      String
  yearLevel   Int
  semester    String
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  subjects    Subject[]
  admissions  Admission[]
  createdAt   DateTime     @default(now())

  @@index([course, semester, yearLevel])
  @@map("course_sections")
}

model Subject {
  id         String        @id @default(uuid())
  code       String
  title      String
  units      Int
  dayOfWeek  Int           @default(1)
  startTime  String        @default("08:00")
  endTime    String        @default("09:00")
  sectionId  String
  section    CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  admissions AdmissionSubject[]
  createdAt DateTime      @default(now())

  @@unique([sectionId, code])
  @@map("subjects")
}

model Admission {
  id             String          @id @default(uuid())
  studentId      String
  sectionId      String
  status         AdmissionStatus @default(DRAFT)
  paymentStatus  PaymentStatus   @default(UNPAID)
  enrollmentFee  Decimal         @db.Decimal(10, 2)
  subjectFees    Decimal         @db.Decimal(10, 2)
  otherFees      Decimal         @db.Decimal(10, 2)
  totalFees      Decimal         @db.Decimal(10, 2)
  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section        CourseSection   @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subjects       AdmissionSubject[]
  submittedAt    DateTime?
  finalizedAt    DateTime?
  codesSentAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([studentId, sectionId])
  @@index([status, paymentStatus])
  @@map("admissions")
}

model AdmissionSubject {
  admissionId String
  subjectId   String
  schedule    String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([admissionId, subjectId])
  @@map("admission_subjects")
}

